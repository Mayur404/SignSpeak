# Camera Network Configuration (5G Lab / RTSP)
# The 5G modem assigns a new dynamic WAN IP each time it reconnects to 5G.
# To find the current IP, connect your laptop via Ethernet to the modem/camera LAN
# and open the modem status page at http://192.168.128.1 (laptop IP 192.168.128.100).
# Note the "WAN IPv4 Address" (for example, 10.101.0.70).
CAMERA_HOST=10.101.0.70

# Optional: Sarvam AI API Key for Indian Language Speech Synthesis
SARVAM_API_KEY=your_sarvam_api_key
