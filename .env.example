# ==============================================================================
# SignSpeak — 5G Edge & Camera Configuration Template
# ==============================================================================

# Camera IP Address (5G Dynamic WAN IP or Direct Ethernet)
# The 5G modem assigns a dynamic WAN IP each time it reconnects (e.g. 10.101.0.70).
# NOTE: The modem administration page (192.168.128.1) is NOT accessible from Wi-Fi
# or over the 5G network. You MUST connect your laptop directly to the modem via
# an Ethernet cable (set your laptop static IP to 192.168.128.100, mask 255.255.255.0).
# - Modem Status Page: http://192.168.128.1 (find WAN IPv4 Address)
# - Camera Direct Web Login: http://192.168.128.10:8080 (admin / admin123)
CAMERA_HOST=10.101.0.74

# Web Dashboard Port & Host
WEB_HOST=0.0.0.0
WEB_PORT=8090

# Optional: Sarvam AI API Key for Indian Language Speech Synthesis
SARVAM_API_KEY=
